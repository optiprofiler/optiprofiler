# Include license and readme
include LICENSE
include README.rst
# Third-party notices (the bundled S2MPJ licence text itself also travels with
# the subset under python/optiprofiler/problem_libs/s2mpj in both artifacts).
include THIRD_PARTY_NOTICES.md
recursive-include licenses *.txt

# Include the EvalReport JSON Schemas (runtime package resources)
recursive-include python/optiprofiler/schemas *.schema.json

# Include problem libraries data files
recursive-include python/optiprofiler/problem_libs *.py *.txt *.csv *.md
include python/optiprofiler/problem_libs/s2mpj/src/list_of_python_problems

# Exclude unnecessary files
global-exclude .git*
global-exclude .DS_Store
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
prune python/optiprofiler/problem_libs/*/.github
recursive-include python/optiprofiler/tests/fixtures *.json
